# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin.
# .env asla commit edilmemelidir (.gitignore içinde).

# --- Veritabanı ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=security_assistant
DATABASE_URL=postgresql+asyncpg://app:change-me@postgres:5432/security_assistant

# --- Redis / görev kuyruğu ---
REDIS_URL=redis://redis:6379/0

# --- AI sağlayıcı ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Yalnızca bu Telegram user ID'lerine izin verilir (virgülle ayrılmış)
TELEGRAM_ALLOWED_USER_IDS=

# --- Uygulama ---
APP_SECRET_KEY=change-me
ENVIRONMENT=development
