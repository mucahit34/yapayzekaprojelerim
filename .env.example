# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin.
# .env asla commit edilmemelidir (.gitignore içinde).

# --- Veritabanı ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=security_assistant
DATABASE_URL=postgresql+asyncpg://app:change-me@postgres:5432/security_assistant

# --- Redis / görev kuyruğu ---
# Şu an hiçbir servis bunu kullanmıyor — mimari planda belirtilen 'uzun
# süren görevler için görev kuyruğu' henüz uygulanmadı (bkz. docker-compose.yml).
REDIS_URL=redis://redis:6379/0

# --- AI sağlayıcı ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Yalnızca bu Telegram user ID'lerine izin verilir (virgülle ayrılmış)
TELEGRAM_ALLOWED_USER_IDS=

# --- Uygulama ---
APP_SECRET_KEY=change-me
ENVIRONMENT=development
# Virgülle ayrılmış izinli CORS origin listesi. docker-compose.yml bunu
# dockerized frontend için (8081) override eder; burası yalnızca yerel
# (docker'sız) `npm run dev` (5173) ile backend'i doğrudan çalıştırırken
# kullanılır.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
